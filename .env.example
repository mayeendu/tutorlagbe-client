# Express API origin. Browser payment requests use the same-origin Next.js proxy.
TUTORLAGBE_API_URL=http://127.0.0.1:8000
BETTER_AUTH_URL=http://localhost:3000
# Set only when the authentication database uses the plural collection.
TUTORLAGBE_USER_COLLECTION=user
# Optional in development. Prefer the mock for Pro when Express enables both checkouts.
# TUTORLAGBE_CHECKOUT_MODE=mock
